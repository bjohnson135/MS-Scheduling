# Env-var registry for MS-Scheduling.
# This is the source of truth; docs/env-vars.md is generated from it.
# Copy to .env (gitignored) for local dev. Compose entrypoints fail loud
# if any REQUIRED variable is unset.

# === REQUIRED for any service to boot ===

# Used by Faraday and any service that signs/verifies sessions.
# Generate locally with: openssl rand -hex 32
SIGNING_SECRET=

# CSRF token signing key. Different from SIGNING_SECRET.
# Generate locally with: openssl rand -hex 32
CSRF_SECRET=

# MySQL DSNs for the two databases. With docker compose, host = mysql, port = 3306.
ACCOUNT_MYSQL_CONFIG=mysql://root:devroot@tcp(mysql:3306)/account?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
COMPANY_MYSQL_CONFIG=mysql://root:devroot@tcp(mysql:3306)/company?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# === REQUIRED for outbound email (mailgun-go) ===
# In dev these point at mailhog (host=mailhog, port=1025) and credentials are unused.
MAILGUN_API_KEY=dev-noop-key
MAILGUN_DOMAIN=staffjoy.local
MAILGUN_PUBLIC_API_KEY=dev-noop-public-key

# === OPTIONAL: third-party integrations ===

# Sentry DSN — leave empty to disable error reporting in dev.
SENTRY_DSN=

# reCAPTCHA secret — empty in dev (the verifier returns success in stub mode).
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# Intercom — empty in dev (the client is a no-op).
INTERCOM_APP_ID=
INTERCOM_API_KEY=

# === DEV-ONLY ===

# Port Faraday binds on the host. If 8080 is occupied, set to 8081 etc.
STAFFJOY_PORT=8080

# Set to "development", "staging", or "production". Defaults to development.
ENV=development
