# Local dev .env — copy to .env and fill in.
# `make bootstrap` does this for you.
#
# See .env.schema for the canonical reference.

# Required for any service to boot.
SIGNING_SECRET=replace_with_openssl_rand_hex_32
CSRF_SECRET=replace_with_a_different_openssl_rand_hex_32

# MySQL — defaults match docker-compose.yml.
MYSQL_ROOT_PASSWORD=devroot
ACCOUNT_MYSQL_CONFIG=mysql://root:devroot@tcp(mysql:3306)/account?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
COMPANY_MYSQL_CONFIG=mysql://root:devroot@tcp(mysql:3306)/company?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci

# Mailgun — dev defaults are no-ops; mailhog catches outgoing mail.
MAILGUN_API_KEY=dev-noop-key
MAILGUN_DOMAIN=staffjoy.local
MAILGUN_PUBLIC_API_KEY=dev-noop-public-key

# Optional integrations — leave empty in dev.
SENTRY_DSN=
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
INTERCOM_APP_ID=
INTERCOM_API_KEY=

# Host ports (override if 8080 / 3306 / 8025 occupied).
STAFFJOY_PORT=8080
MYSQL_HOST_PORT=3306
MAILHOG_UI_PORT=8025

# Misc.
ENV=development
LOG_LEVEL=debug
