# Multistage Dockerfile for the React frontends (app/, myaccount/).
# Build args:
#   APP_PATH — repo-relative path to the frontend source dir (e.g. "app", "myaccount").
#
# Stage 1 (Node): pnpm install + webpack build → /dist
# Stage 2 (nginx): serve /dist as a static site under a path-prefix that
# matches Faraday's path-based router (see ADR-0004).

ARG NODE_VERSION=20.18.0

# ---------- build stage ----------
FROM node:${NODE_VERSION}-alpine AS build
ARG APP_PATH
RUN test -n "${APP_PATH}" || (echo "ERROR: APP_PATH build-arg is required" && exit 1)
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /repo
# Copy the entire repo so app/ + frontend_resources/ + webassets/ keep their
# sibling layout that webpack relative imports rely on
# (e.g. `../../../../frontend_resources/images/staffjoy.png`).
# .dockerignore on the repo root keeps node_modules etc. out.
COPY ${APP_PATH}/.npmrc* /repo/${APP_PATH}/
COPY ${APP_PATH}/package.json ${APP_PATH}/yarn.lock* ${APP_PATH}/pnpm-lock.yaml* /repo/${APP_PATH}/
WORKDIR /repo/${APP_PATH}
RUN pnpm install --no-frozen-lockfile || npm install

COPY ${APP_PATH}/ /repo/${APP_PATH}/
COPY frontend_resources /repo/frontend_resources
COPY webassets /repo/webassets
RUN pnpm run build || npm run build

# The runtime stage expects /src/dist; bridge that.
RUN mkdir -p /src && cp -r dist /src/dist

# ---------- runtime stage ----------
FROM nginx:alpine
ARG APP_PATH
COPY --from=build /src/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=2s --retries=3 \
  CMD wget -qO- http://localhost/healthz || exit 1
